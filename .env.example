SENTRYDOCK_URL=http://host.docker.internal:3000
SENTRYDOCK_GRPC_URL=host.docker.internal:50051
AGENT_TOKEN=
AGENT_NAME=agent-1
AGENT_TRANSPORT=ws
# Optional. Unset = auto-detect (Docker Desktop context, rootless, /var/run/docker.sock)
# DOCKER_SOCKET=/var/run/docker.sock
# Where catalog Compose YAML is written. In docker-compose.yml this is a named volume.
# SENTRYDOCK_COMPOSE_DIR=/var/lib/sentrydock/compose
